{
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/usr/bin/env",
      "args": ["bash"],
      "icon": "terminal-bash"
    },
    "nix-shell": {
      "path": "/usr/bin/env",
      "args": ["nix-shell"],
      "icon": "terminal"
    }
  },
  "terminal.integrated.inheritEnv": true,
  "terminal.integrated.env.linux": {
    "NIXPKGS_ALLOW_UNFREE": "1"
  }
}
